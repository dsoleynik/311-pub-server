NODE_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=3312
PUBLIC_ORIGIN=http://127.0.0.1:5178
BACKOFFICE_ORIGIN=https://localhost:5174
RABBITMQ_URL=amqp://127.0.0.1:5672
RABBITMQ_RPC_QUEUE=311.rpc.v1
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=311:pub:
AUTH_ENABLED=false
# Required for real sign-in. This service uses GARDEN_PUB_RPC_SECRET from ERP.
# GRAVUM_RABBITMQ_URL=amqp://127.0.0.1:5672
# GRAVUM_RPC_SECRET=generate-a-different-secret-of-at-least-32-characters
# GRAVUM_ISSUER=exact-issuer-from-gravum
# GRAVUM_TENANT_ID=tenant-uuid-from-gravum
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SESSION_ENCRYPTION_KEY_BASE64=replace-with-generated-key
# Same public key as core; never put the private key in this service or the client.
# VAPID_PUBLIC_KEY=public-key
